# Auth — HMAC secret สำหรับเซ็น cookie ตัวตน (บังคับใน production)
# สร้าง: openssl rand -base64 32
GN_AUTH_SECRET=change-me

# Base URL (ใช้สร้าง LINE callback URL)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Supabase — ตั้งครบ 2 ตัว = สลับจาก JSON store เป็น Supabase อัตโนมัติ
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# LINE Login (v1.1) — ไม่ตั้ง = ปุ่ม login แจ้ง not_configured แต่แอปใช้ได้ปกติ
LINE_CHANNEL_ID=your-channel-id
LINE_CHANNEL_SECRET=your-channel-secret

# Chat-to-plan AI — ลำดับ engine: Claude (ถ้ามี key) → Ollama (ถ้ารันอยู่) → quick parser
# ไม่ตั้งอะไรเลย = quick parser (keyword match) — ไม่มี error
ANTHROPIC_API_KEY=sk-ant-your-key

# Ollama (LLM ในเครื่อง — ฟรี ไม่ต้องมี key) · ติดตั้ง: brew install ollama แล้ว ollama pull gemma4:12b
# ค่า default ในโค้ดตรงกับสองบรรทัดนี้อยู่แล้ว — ตั้งเมื่อต้องการ override เท่านั้น
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b
